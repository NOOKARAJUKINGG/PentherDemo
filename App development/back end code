import tkinter as tk

class AppUI(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("App User Interface")
        self.geometry("400x300")

        self.label = tk.Label(self, text="Welcome to the App!", font=("Arial", 16))
        self.label.pack(pady=20)

        self.entry = tk.Entry(self, width=30)
        self.entry.pack(pady=10)

        self.button = tk.Button(self, text="Submit", command=self.on_submit)
        self.button.pack(pady=10)

        self.result = tk.Label(self, text="", font=("Arial", 12))
        self.result.pack(pady=10)

    def on_submit(self):
        user_input = self.entry.get()
        self.result.config(text=f"You entered: {user_input}")

if __name__ == "__main__":
    app = AppUI()
    app.mainloop()